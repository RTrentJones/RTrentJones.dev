---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
---

<Base>
  <section class="intro">
    <h1>Trent Jones</h1>
    <p class="lede">
      I'm a software engineer. Outside work I build things that scratch an itch, answer a
      technical question, or give me an excuse to learn a part of the stack I don't normally touch.
    </p>
    <p class="lede">
      Lately that's meant putting the Kafka protocol inside Postgres, building an MCP server for
      exploring genomic data, and accidentally turning the deployment scripts for my side projects
      into a project of their own.
    </p>
  </section>

  <section class="selected">
    <h2>Projects</h2>
    <ul class="selected-list">
      {
        projects.map((p) => (
          <li>
            <a href={`/${p.id}/`}>{p.data.title}</a>
            <span class="sig">{p.data.tagline ?? p.data.summary}</span>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/projects/">All projects →</a></p>
  </section>

  <div class="home">
    <div class="writing">
      <h2>Writing</h2>
      <div class="post-list">
        {
          posts.map((post) => (
            <PostCard
              href={`/blog/${post.id}/`}
              title={post.data.title}
              date={post.data.date}
              description={post.data.description}
            />
          ))
        }
      </div>
      <p class="more"><a href="/blog/">All posts →</a></p>
    </div>

    <aside class="sidebar">
      <section class="panel">
        <h2>About</h2>
        <p>
          I studied neuroscience and computer science at USC and started my career working on
          software for a clinical genetics lab before moving into larger product and platform
          systems. The biology part never entirely went away.
        </p>
        <p class="more"><a href="/about/">More about me →</a></p>
      </section>
    </aside>
  </div>
</Base>

<style>
  .intro {
    margin: 1.5rem 0 2.75rem;
  }
  .intro h1 {
    margin-bottom: 0.6rem;
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--fg-muted);
    max-width: var(--measure);
  }

  .selected {
    margin: 0 0 2.75rem;
  }
  .selected > h2 {
    margin-top: 0;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  .selected-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem 1.75rem;
  }
  @media (min-width: 720px) {
    .selected-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .selected-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .selected-list a {
    font-weight: 650;
    color: var(--fg);
    text-decoration: none;
  }
  .selected-list a:hover {
    color: var(--accent);
  }
  .selected-list .sig {
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  /* Single column by default (writing first, then the sidebar stacks below it). */
  .home {
    display: grid;
    gap: 3rem;
  }
  /* Two columns when there's room: writing on the left, about + projects on the right. */
  @media (min-width: 860px) {
    .home {
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 3.5rem;
      align-items: start;
    }
  }

  .writing > h2 {
    margin-top: 0;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  .post-list {
    display: grid;
    gap: 1.5rem;
  }
  .more {
    margin-top: 1.25rem;
    font-size: 0.95rem;
  }

  .sidebar {
    display: grid;
    gap: 2.5rem;
    align-content: start;
  }
  .panel h2 {
    margin-top: 0;
    font-size: var(--text-base);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }
  .panel p {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .panel .more {
    margin-top: 0.9rem;
  }
</style>
